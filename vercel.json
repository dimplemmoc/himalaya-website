{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/explore", "destination": "/experience.html" },
    { "source": "/journeys", "destination": "/package.html" },
    { "source": "/our-story", "destination": "/about.html" },
    { "source": "/journal", "destination": "/blog.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/blog/:slug", "destination": "/blog-details.html?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
